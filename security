@wl.command(name="add")
@app_commands.checks.has_permissions(administrator=True)
async def add(interaction, member: discord.Member):

    async with aiosqlite.connect("security.db") as db:
        await db.execute(
            "INSERT OR IGNORE INTO whitelist VALUES(?,?)",
            (interaction.guild.id, member.id)
        )
        await db.commit()

    await interaction.response.send_message(
        f"{member.mention} added to whitelist."
    )

@wl.command(name="remove")
@app_commands.checks.has_permissions(administrator=True)
async def remove(interaction, member: discord.Member):

    async with aiosqlite.connect("security.db") as db:
        await db.execute(
            "DELETE FROM whitelist WHERE guild_id=? AND user_id=?",
            (interaction.guild.id, member.id)
        )
        await db.commit()

    await interaction.response.send_message(
        f"{member.mention} removed."
    )

