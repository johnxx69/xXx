# ---------------- LOGGING ----------------

async def log(guild, title, description, color=discord.Color.red()):
    s = await get_settings(guild.id)
    if not s["log_channel"]:
        return

    channel = guild.get_channel(s["log_channel"])
    if channel:
        embed = discord.Embed(
            title=title,
            description=description,
            color=color
        )
        embed.timestamp = discord.utils.utcnow()
        await channel.send(embed=embed)

# ---------------- SPAM ----------------

message_cache = {}

@bot.event
async def on_message(message):

    if message.author.bot or not message.guild:
        return

    s = await get_settings(message.guild.id)

    # Anti Invite
    if s["anti_invite"]:
        if "discord.gg/" in message.content.lower():
            try:
                await message.delete()
                await message.author.timeout(
                    discord.utils.utcnow() + discord.utils.timedelta(minutes=10),
                    reason="Discord Invite"
                )
                await log(
                    message.guild,
                    "Invite Blocked",
                    f"{message.author.mention} posted an invite."
                )
            except:
                pass

    # Anti Spam
    if s["anti_spam"]:
        now = time.time()

        cache = message_cache.setdefault(message.author.id, [])
        cache.append(now)

        cache[:] = [x for x in cache if now - x < 5]

        if len(cache) >= 6:
            try:
                await message.author.timeout(
                    discord.utils.utcnow() + discord.utils.timedelta(minutes=5),
                    reason="Spam"
                )
                await log(
                    message.guild,
                    "Spam Detected",
                    f"{message.author.mention} was timed out."
                )
                cache.clear()
            except:
                pass

    await bot.process_commands(message)

