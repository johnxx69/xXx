# ---------------- ANTI CHANNEL DELETE ----------------

@bot.event
async def on_guild_channel_delete(channel):

    guild = channel.guild

    async for entry in guild.audit_logs(
            limit=1,
            action=discord.AuditLogAction.channel_delete):

        if await is_whitelisted(guild.id, entry.user.id):
            return

        try:
            await entry.user.timeout(
                discord.utils.utcnow() + discord.utils.timedelta(hours=1),
                reason="Channel Deletion Protection"
            )

            await log(
                guild,
                "Channel Protection",
                f"{entry.user.mention} deleted **{channel.name}**."
            )
        except:
            pass

