# ---------------- MASS BAN DETECTION ----------------

ban_tracker = {}

@bot.event
async def on_member_ban(guild, user):

    async for entry in guild.audit_logs(
            limit=1,
            action=discord.AuditLogAction.ban):

        if await is_whitelisted(guild.id, entry.user.id):
            return

        now = time.time()
        cache = ban_tracker.setdefault(entry.user.id, [])
        cache.append(now)

        cache[:] = [x for x in cache if now - x < 20]

        if len(cache) >= 3:
            try:
                await entry.user.timeout(
                    discord.utils.utcnow() + discord.utils.timedelta(hours=2),
                    reason="Mass Ban Protection"
                )

                await log(
                    guild,
                    "Mass Ban Blocked",
                    f"{entry.user.mention} exceeded ban threshold."
                )
            except:
                pass

# ---------------- SLASH COMMANDS ----------------

security = app_commands.Group(
    name="security",
    description="Security commands"
)

@security.command(name="setlog")
@app_commands.checks.has_permissions(administrator=True)
async def setlog(interaction, channel: discord.TextChannel):

    async with aiosqlite.connect("security.db") as db:
        await db.execute("""
        INSERT INTO settings(guild_id,log_channel)
        VALUES(?,?)
        ON CONFLICT(guild_id)
        DO UPDATE SET log_channel=excluded.log_channel
        """, (interaction.guild.id, channel.id))
        await db.commit()

    await interaction.response.send_message(
        f"Log channel set to {channel.mention}"
    )

@security.command(name="status")
async def status(interaction):

    s = await get_settings(interaction.guild.id)

    embed = discord.Embed(
        title="Security Status",
        color=discord.Color.green()
    )

    embed.add_field(name="Anti Spam", value="ON" if s["anti_spam"] else "OFF")
    embed.add_field(name="Anti Invite", value="ON" if s["anti_invite"] else "OFF")
    embed.add_field(name="Anti Raid", value="ON" if s["anti_raid"] else "OFF")

    await interaction.response.send_message(embed=embed)

@security.command(name="lockdown")
@app_commands.checks.has_permissions(administrator=True)
async def lockdown(interaction):

    for channel in interaction.guild.text_channels:
        try:
            await channel.set_permissions(
                interaction.guild.default_role,
                send_messages=False
            )
        except:
            pass

    await log(
        interaction.guild,
        "LOCKDOWN",
        f"Activated by {interaction.user.mention}",
        discord.Color.dark_red()
    )

    await interaction.response.send_message(
        "Server locked down."
    )

bot.tree.add_command(security)

